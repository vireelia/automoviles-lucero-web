# Dominio real definitivo de esta landing (para el sitemap, robots.txt y las
# URLs canónicas). Sin confirmar todavía -- usa un valor de ejemplo hasta que
# se compre/confirme el dominio real.
NEXT_PUBLIC_SITE_URL=https://www.automoviles-lucero.es

# URL real del backend/CRM de Automóviles Lucero (automoviles-lucero, en
# producción: https://virelia-hub-lucero.lzc0bh.easypanel.host). La ruta de
# API de esta landing (/api/leads) le manda ahí cada solicitud real, server-
# to-server (nunca desde el navegador).
LUCERO_CRM_URL=https://virelia-hub-lucero.lzc0bh.easypanel.host

# Opcional. El endpoint real que recibe los leads (/tools/create_lead) no
# exige token hoy (lo usan también los agentes de voz/chat sin él) -- si en
# algún momento se protege, poner aquí el mismo ADMIN_TOKEN real del CRM.
LUCERO_ADMIN_TOKEN=
